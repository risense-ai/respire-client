{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Respire",
  "version": "1.0.0",
  "identifier": "ai.risense.respire",
  "build": {
    "frontendDist": "../tree-ui/dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Respire 记忆库",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/rsrs"
    ],
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "useLocalToolsDir": true,
    "resources": {
      "../../models/bge-base-zh-v1.5/": "models/bge-base-zh-v1.5/"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/rsrs": "binaries/rsrs",
          "/usr/share/fonts/truetype/lxgw/LXGWMarkerGothic-Regular.ttf": "fonts/LXGWMarkerGothic-Regular.ttf",
          "/usr/share/doc/respire/OFL-LXGWMarkerGothic.txt": "fonts/OFL.txt"
        },
        "postInstallScript": "scripts/postinst.sh"
      },
      "rpm": {
        "files": {
          "/usr/bin/rsrs": "binaries/rsrs",
          "/usr/share/fonts/truetype/lxgw/LXGWMarkerGothic-Regular.ttf": "fonts/LXGWMarkerGothic-Regular.ttf",
          "/usr/share/doc/respire/OFL-LXGWMarkerGothic.txt": "fonts/OFL.txt"
        },
        "postInstallScript": "scripts/postinst.sh"
      }
    }
  }
}